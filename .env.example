NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
NEXT_PUBLIC_WHATSAPP_NUMBER=50400000000

# Server-side only. Habilita el llenado automático del formulario de inventario
# con la cámara (visión de Gemini). Obtenela en https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opcional. Por defecto gemini-3.5-flash-lite (~$0.0008 por escaneo).
# Alternativa mas barata: gemini-3.1-flash-lite (~$0.0006, un poco menos preciso
# con los tonos). Los modelos flash completos cuestan 4x y no mejoran esta tarea.
# GEMINI_MODEL=gemini-3.5-flash-lite
